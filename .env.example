APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=
APPWRITE_USERS_COLLECTION_ID=
APPWRITE_DISEASES_COLLECTION_ID=
APPWRITE_PRESCRIPTIONS_COLLECTION_ID=
APPWRITE_MEDICINES_COLLECTION_ID=
APPWRITE_DOSE_LOGS_COLLECTION_ID=

NODE_ENV=development
PORT=5000
TZ=Asia/Kolkata

# Resend (preferred) — get free API key at resend.com
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=MedTrack <you@yourdomain.com>

# Gmail SMTP (fallback) — requires App Password from myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

PATIENT_EMAIL=patient@example.com
